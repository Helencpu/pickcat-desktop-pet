{
  "manifest_version": 3,
  "name": "PICKCAT 网页小桌宠",
  "version": "2.0.0",
  "description": "一只来自 pickcat.dao3.fun 的小猫桌宠：可拎起放下、带重力与落地弹跳，点击会被压扁并发出小黄鸭的吱吱声。",
  "author": "Doubao",
  "icons": {
    "128": "pet.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pet.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
